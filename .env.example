# =====================================================================
#  YZ Yayın Takip — environment variables
#  Copy to `.env` and fill in real values. Never commit `.env`.
#  Dokploy reads these from its UI; locally they're loaded by Vite.
# =====================================================================

# ----- Public app config (exposed to the browser via Vite) -----

# Where the browser talks to the backend.
#
# LEAVE THIS EMPTY. Both runtimes proxy /api/* to the backend, so the SPA
# talks to its own origin and never makes a cross-site request:
#   - dev:  Vite proxy      (client/vite.config.js) → http://localhost:4000
#   - prod: serve.cjs proxy (API_UPSTREAM below)    → the API container
#
# This is load-bearing, not cosmetic. The session is an httpOnly cookie
# with SameSite=lax. Point the SPA at a backend on a different registrable
# domain (as the old sslip.io override did) and the browser silently
# refuses to store the cookie from /auth/login or send it on /auth/me —
# every request comes back 401 and users can't stay logged in.
#
# Only set this to reach a backend on another HOST, and only if that host
# is same-site with the SPA (a sibling subdomain like api.yt.example.com).
# For a genuinely cross-site backend you must ALSO set
# SESSION_COOKIE_SAMESITE=none + SESSION_COOKIE_SECURE=true on the server.
VITE_API_BASE_URL=

# Where serve.cjs forwards /api/* in production. Dokploy resolves service
# slugs on the internal network — set this to the API service's slug and
# port. Never public; this hop never leaves the internal network.
API_UPSTREAM=http://backend:4000

# Backend base URL — used by the Fastify server, not the SPA.
API_BASE_URL=http://localhost:4000

# Postgres connection string.
# - Local dev (Docker Compose): the user/password match docker-compose.yml.
# - Dokploy prod: use the internal URL Dokploy prints when you create
#   the Postgres service (e.g. postgres://postgres:<password>@yz-postgres:5432/yz_yayin_takip).
DATABASE_URL=postgres://postgres:CHANGEME@localhost:5432/yz_yayin_takip

# Bootstrap behaviour on server start.
MIGRATE_ON_BOOT=true
SEED_ON_BOOT=false

# Auth: this pass trusts the X-User-Id header. Set to 'false' once real
# OAuth/cookie sessions are wired (next pass).
TRUST_HEADER_AUTH=true

# CORS allowlist for the SPA. Comma-separated.
# Production: include the public SPA hostname. Keep localhost entries for dev.
CORS_ORIGINS=https://yt.mucitkarinca.com,http://localhost:5173,http://localhost:4173

# OAuth (planned; backend not deployed yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis (sessions, cache, pub-sub) — not built yet.
REDIS_URL=

# Nodemailer — invitation + stage-change notifications.
# Leave SMTP_HOST unset to print invite emails to the server log instead of
# sending real mail (useful for local dev and CI).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_YOUR_RESEND_API_KEY
SMTP_FROM="YZ Yayın Takip <noreply@yt.mucitkarinca.com>"
SMTP_SECURE=false

# Public URL the invitation email links to (the SPA). Must be reachable
# from the invitee's mailbox so they can click the "Şifre Belirle" button.
# Set this to your production hostname in Dokploy.
INVITE_BASE_URL=https://yt.mucitkarinca.com

# Cookie signing secret (planned)
SESSION_SECRET=
